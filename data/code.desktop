# Overrides the vendor /usr/share/applications/code.desktop, which launches VS
# Code on the GL path. A .desktop in XDG_DATA_HOME replaces the system one
# wholesale rather than merging with it, so this has to carry every key the
# original does -- there is no way to override Exec alone.
#
# Exec is the bare name, not /usr/share/code/code with the flags spelled out
# again: it resolves to bin/code from this repo, which is where the renderer
# flags live. uwsm/env guarantees ~/.local/bin is on the session PATH before
# anything is launched, and it is first in the systemd user manager's PATH, so
# the launcher finds the shim rather than /usr/bin/code. One file decides which
# renderer VS Code gets, whether it is started from the launcher or a terminal.
#
# Dropped from the vendor copy: the eleven Name[xx] translations of the action
# below. Nothing else -- MimeType and StartupWMClass in particular are load
# bearing, the first for opening .code-workspace files and the second for
# window rules matching the class Code actually sets.

[Desktop Entry]
Name=Visual Studio Code
Comment=Code Editing. Redefined.
GenericName=Text Editor
Exec=code %F
Icon=vscode
Type=Application
StartupNotify=false
StartupWMClass=Code
Categories=TextEditor;Development;IDE;
MimeType=application/x-code-workspace;
Actions=new-empty-window;
Keywords=vscode;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=code --new-window %F
Icon=vscode
