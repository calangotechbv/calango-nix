#!/usr/bin/env python3
"""NetworkManager secret agent, backed by the login keyring.

Why this exists: every saved wifi connection here carries psk-flags=1, so
NetworkManager stores no key and asks a registered agent for one at connect
time. Nothing else on this desktop is an agent -- Quickshell drives NM over
seven D-Bus interfaces and AgentManager is not among them -- so saved networks
failed with NoSecrets, which the panel reported as a wrong password.

See ../docs/superpowers/specs/2026-08-10-nm-secret-agent-design.md.
"""

import argparse
import getpass
import signal
import sys
import warnings

import gi

# commit_changes in cmd_adopt is deprecated in favour of the async update2, and
# printed a DeprecationWarning over the command's own output on every run. The
# call is correct and stays; see the comment at its call site. Narrow on purpose
# -- this filters that one message, not DeprecationWarning as a category.
warnings.filterwarnings("ignore", message=r".*commit_changes is deprecated.*")

gi.require_version("NM", "1.0")
gi.require_version("Secret", "1")
from gi.repository import GLib, NM, Secret  # noqa: E402

# The only setting this agent answers for. Everything else is declined by
# returning no secrets, which leaves 802.1X and VPN flows exactly as they are
# rather than half-answering them. Spec decision 4.
WIFI = "802-11-wireless-security"
PSK = "psk"

# An explicit schema, not an opaque blob, so seahorse can show and delete these.
SCHEMA = Secret.Schema.new(
    "eu.calangotech.calango-desktop.NetworkSecret",
    Secret.SchemaFlags.NONE,
    {
        "uuid": Secret.SchemaAttributeType.STRING,
        "setting": Secret.SchemaAttributeType.STRING,
        "key": Secret.SchemaAttributeType.STRING,
    },
)


def log(msg):
    # Never called with a settings dict. See the redaction rule in the plan's
    # Global Constraints.
    print(f"nm-secret-agent: {msg}", file=sys.stderr, flush=True)


def _attrs(uuid):
    # Keyed by UUID, not SSID: the UUID is what NM hands the agent, and it
    # survives an SSID being reused for a different network.
    return {"uuid": uuid, "setting": WIFI, "key": PSK}


def keyring_get(uuid):
    return Secret.password_lookup_sync(SCHEMA, _attrs(uuid), None)


def keyring_set(uuid, label, secret):
    Secret.password_store_sync(
        SCHEMA, _attrs(uuid), Secret.COLLECTION_DEFAULT, label, secret, None)


def keyring_clear(uuid):
    return Secret.password_clear_sync(SCHEMA, _attrs(uuid), None)


class KeyringAgent(NM.SecretAgentOld):
    """Answers GetSecrets from the login keyring, and nothing else."""

    def do_get_secrets(self, connection, connection_path, setting_name,
                       hints, flags, callback, user_data):
        if setting_name != WIFI:
            log(f"declining {setting_name}: this agent answers {WIFI} only")
            callback(self, connection, None, self._no_secrets())
            return

        uuid = connection.get_uuid()
        secret = None
        try:
            secret = keyring_get(uuid)
        except GLib.Error as exc:
            # A locked or absent keyring lands here. Not a crash: the panel
            # prompts, per spec decision 5.
            log(f"keyring unavailable for {uuid}: {exc.message}")

        if not secret:
            log(f"no stored key for {uuid}")
            callback(self, connection, None, self._no_secrets())
            return

        log(f"answering {uuid} from the keyring")
        secrets = GLib.Variant("a{sa{sv}}",
                               {WIFI: {PSK: GLib.Variant("s", secret)}})
        callback(self, connection, secrets, None)

    # The three completion callbacks do NOT share an arity. GetSecretsFunc takes
    # four -- (agent, connection, secrets, error) -- while SaveSecretsFunc and
    # DeleteSecretsFunc take three, with no secrets argument. PyGObject binds
    # user_data implicitly in all three. The spike only exercised GetSecrets, so
    # its four-argument finding got generalised to the other two and both raised
    # TypeError at the first real save and the first real forget.
    def do_save_secrets(self, connection, connection_path, callback, user_data):
        setting = connection.get_setting_wireless_security()
        if setting is not None:
            psk = setting.get_psk()
            if psk:
                keyring_set(connection.get_uuid(),
                            f"Wi-Fi key for {connection.get_id()}", psk)
                log(f"saved key for {connection.get_uuid()}")
        callback(self, connection, None)

    def do_delete_secrets(self, connection, connection_path, callback, user_data):
        uuid = connection.get_uuid()
        try:
            if keyring_clear(uuid):
                log(f"removed key for {uuid}")
        except GLib.Error as exc:
            log(f"could not remove key for {uuid}: {exc.message}")
        callback(self, connection, None)

    def do_cancel_get_secrets(self, connection_path, setting_name):
        # Nothing to cancel: every lookup above is synchronous and immediate.
        pass

    @staticmethod
    def _no_secrets():
        return GLib.Error.new_literal(
            NM.SecretAgentError.quark(),
            "no stored key",
            int(NM.SecretAgentError.NOSECRETS))


# Cached for the process lifetime, and that is load-bearing rather than tidy.
# A RemoteConnection is only valid while the Client that produced it is alive:
# let the Client fall out of scope and the next call on the connection fails
# with "Object is no longer in the client cache". The first --adopt did exactly
# that, because _find used to drop the Client on return.
_CLIENT = None


def _client():
    global _CLIENT
    if _CLIENT is None:
        _CLIENT = NM.Client.new(None)
    return _CLIENT


def _find(ssid):
    for c in _client().get_connections():
        if c.get_id() == ssid:
            return c
    return None


def cmd_list():
    rows = 0
    for c in _client().get_connections():
        if c.get_setting_wireless() is None:
            continue
        uuid = c.get_uuid()
        stored = "yes" if keyring_get(uuid) else "no"
        print(f"  {c.get_id():24} key-in-keyring={stored}  {uuid}")
        rows += 1
    if rows == 0:
        print("  no wifi connections")
    return 0


def cmd_store(ssid):
    conn = _find(ssid)
    if conn is None:
        log(f"no saved connection named {ssid!r}")
        return 1
    # Never from argv. Shell history and ps would both carry it.
    secret = getpass.getpass(f"Key for {ssid}: ")
    if not secret:
        log("empty key, nothing stored")
        return 1
    keyring_set(conn.get_uuid(), f"Wi-Fi key for {ssid}", secret)
    print(f"stored key for {ssid}")
    return 0


def cmd_forget(ssid):
    conn = _find(ssid)
    if conn is None:
        log(f"no saved connection named {ssid!r}")
        return 1
    print("removed" if keyring_clear(conn.get_uuid()) else "nothing stored")
    return 0


def cmd_adopt(ssid):
    """Move a system-stored key into the keyring and hand the slot to us.

    A network joined through the panel comes back with psk-flags=0: Quickshell's
    connectWithPsk writes the key into the profile, so NetworkManager holds it in
    /etc/NetworkManager/system-connections and never asks an agent. That is the
    plain-file world this agent exists to avoid, and it happens silently on every
    rejoin. This converts one such connection: read the key out, put it in the
    keyring, then set psk-flags=1 so NM drops its copy and starts asking us.
    """
    conn = _find(ssid)
    if conn is None:
        log(f"no saved connection named {ssid!r}")
        return 1

    sec = conn.get_setting_wireless_security()
    if sec is None:
        log(f"{ssid!r} is not a WPA-PSK connection")
        return 1

    if sec.get_psk_flags() & NM.SettingSecretFlags.AGENT_OWNED:
        print(f"{ssid} is already agent-owned; nothing to adopt")
        return 0

    # Read the stored key. This is the only place this program reads a secret it
    # did not just prompt for, and it is never printed.
    try:
        # get_secrets RETURNS the secrets; it does not fold them into the
        # connection. Without the update_secrets call, get_psk() below stays
        # empty and this looks like a connection with no key at all.
        secrets = conn.get_secrets(NM.SETTING_WIRELESS_SECURITY_SETTING_NAME, None)
        conn.update_secrets(NM.SETTING_WIRELESS_SECURITY_SETTING_NAME, secrets)
    except GLib.Error as exc:
        log(f"could not read the stored key for {ssid}: {exc.message}")
        return 1
    sec = conn.get_setting_wireless_security()
    psk = sec.get_psk()
    if not psk:
        log(f"{ssid} has no stored key to adopt -- nothing was changed")
        return 1

    # Keyring first, deliberately. If this fails we have changed nothing and the
    # connection still works. The reverse order would leave a network whose key
    # NM has dropped and the keyring never received.
    keyring_set(conn.get_uuid(), f"Wi-Fi key for {ssid}", psk)
    if keyring_get(conn.get_uuid()) != psk:
        log("the keyring did not accept the key -- nothing was changed")
        return 1

    sec.set_property(NM.SETTING_WIRELESS_SECURITY_PSK_FLAGS,
                     NM.SettingSecretFlags.AGENT_OWNED)
    try:
        # commit_changes is deprecated in favour of update2, which is async and
        # would need a GLib main loop driven around it. That is a worse trade in
        # a one-shot subcommand than the warning it silences, so the sync call
        # stays and the warning is filtered at the top of this file instead.
        conn.commit_changes(True, None)
    except GLib.Error as exc:
        log(f"could not set psk-flags on {ssid}: {exc.message}")
        log("the key IS in the keyring; the connection is unchanged and still works")
        return 1

    print(f"adopted {ssid}: key is in the keyring, psk-flags is now agent-owned")
    print("this connection now needs this agent running to connect")
    return 0


def run_agent():
    # auto-register defaults to True, so constructing this registers it.
    agent = KeyringAgent(identifier="eu.calangotech.calango-desktop.NetworkSecret")
    # SecretAgentOld is GInitable. auto-register defaults to True but only takes
    # effect once init() has run -- constructing the object is not enough, and
    # get_registered() is False until then. Task 1 found this the hard way.
    agent.init(None)
    if not agent.get_registered():
        # Fatal and loud on purpose: an agent that runs without registering
        # looks healthy and answers nothing.
        log("failed to register with NetworkManager")
        return 1

    loop = GLib.MainLoop()

    def stop(*_args):
        agent.unregister(None)
        loop.quit()
        return GLib.SOURCE_REMOVE

    # Fedora's PyGObject 3.56 deprecates these and logs two warnings per start,
    # pointing at GLibUnix.signal_add. Do not switch: Debian 13's PyGObject
    # 3.50 imports the GLibUnix namespace but does not have signal_add, so the
    # replacement would break suffer outright. Measured on both machines, not
    # assumed. Two cosmetic lines in one journal beats a hasattr shim.
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, stop)
    log("registered")
    loop.run()
    return 0


def main():
    ap = argparse.ArgumentParser(
        description="NetworkManager secret agent backed by the login keyring")
    ap.add_argument("--store", metavar="SSID",
                    help="prompt for a key and store it (never pass it as an argument)")
    ap.add_argument("--forget", metavar="SSID", help="remove a stored key")
    ap.add_argument("--adopt", metavar="SSID",
                    help="move a system-stored key into the keyring and set "
                         "psk-flags to agent-owned")
    ap.add_argument("--list", action="store_true",
                    help="list wifi connections and whether a key is stored")
    args = ap.parse_args()

    if args.list:
        return cmd_list()
    if args.store:
        return cmd_store(args.store)
    if args.forget:
        return cmd_forget(args.forget)
    if args.adopt:
        return cmd_adopt(args.adopt)
    return run_agent()


if __name__ == "__main__":
    sys.exit(main())
